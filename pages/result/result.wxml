<view class="page-shell result-page">
  <view wx:if="{{!result}}" class="empty-panel">
    <view class="empty-title">暂无成绩</view>
    <view class="muted">请先完成一次刷题。</view>
    <button class="primary-button" bindtap="goHome">返回首页</button>
  </view>

  <block wx:else>
    <view class="score-hero">
      <view class="result-mode">{{result.title}}</view>
      <view class="score-number">{{result.percent}}</view>
      <view class="score-label">总分 / 正确率</view>
      <view class="honor-pill">{{result.honor}}</view>
      <view class="score-summary">答对 {{result.correctCount}} 题，答错 {{result.wrongCount}} 题，共 {{result.total}} 题。</view>
    </view>

    <view class="panel">
      <text class="section-title">薄弱点建议</text>
      <view wx:if="{{!result.mistakes.length}}" class="success-note">本次没有错题，继续保持。</view>
      <block wx:else>
        <view class="weak-list">
          <view wx:for="{{result.weakCategories}}" wx:key="key" class="weak-item">
            <text>{{item.label}}</text>
            <text>{{item.wrong}} / {{item.total}} 错</text>
          </view>
        </view>
        <view class="advice-list">
          <view wx:for="{{result.advice}}" wx:key="*this" class="advice-item">{{item}}</view>
        </view>
      </block>
    </view>

    <view class="panel">
      <text class="section-title">错题回看</text>
      <view wx:if="{{!result.mistakes.length}}" class="muted">没有错题可回看。</view>
      <block wx:else>
        <view class="mistake-nav">
          <view
            wx:for="{{result.mistakes}}"
            wx:key="id"
            data-index="{{item.index}}"
            bindtap="jumpToMistake"
            class="mistake-number {{activeMistakeIndex === item.index ? 'active' : ''}}"
          >
            {{item.index}}
          </view>
        </view>
        <view class="mistake-tip">点击题号展开对应错题，再点一次可收起。</view>
      </block>
      <view
        wx:for="{{result.mistakes}}"
        wx:key="id"
        wx:if="{{activeMistakeIndex === item.index}}"
        id="mistake-{{item.index}}"
        class="mistake-card"
      >
        <view class="mistake-head">
          <text>第{{item.index}}题 · {{item.typeLabel}}</text>
          <text>{{item.categoryLabel}}</text>
        </view>
        <view class="mistake-stem">{{item.stem}}</view>
        <view class="answer-line wrong-answer">你的答案：{{item.selectedText}}</view>
        <view class="answer-line right-answer">正确答案：{{item.answerText}}</view>
        <view class="knowledge-line">知识点：{{item.knowledgePoint}}</view>
        <view class="explain-line">{{item.explanation}}</view>
      </view>
    </view>

    <view class="result-actions">
      <button class="ghost-button" bindtap="goHome">返回首页</button>
      <button class="primary-button" bindtap="retryMode">再练一次</button>
    </view>
  </block>
</view>
