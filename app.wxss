page {
  min-height: 100%;
  background: #fff8ed;
  color: #301315;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  border-radius: 8px;
  font-weight: 600;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
}

.primary-button {
  height: 88rpx;
  line-height: 88rpx;
  background: #b5121b;
  color: #fff8ed;
  border-radius: 8px;
  font-size: 30rpx;
}

.primary-button[disabled] {
  background: #d8b9aa;
  color: #fff8ed;
}

.ghost-button {
  height: 80rpx;
  line-height: 80rpx;
  color: #8d1118;
  background: #fff4e0;
  border: 2rpx solid #e7c89b;
  border-radius: 8px;
  font-size: 28rpx;
}

.ghost-button[disabled] {
  color: #b9a59b;
  background: #f2e5d8;
  border-color: #ead9c6;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #7d1016;
  font-size: 32rpx;
  font-weight: 700;
}

.muted {
  color: #806666;
  font-size: 26rpx;
  line-height: 1.6;
}
